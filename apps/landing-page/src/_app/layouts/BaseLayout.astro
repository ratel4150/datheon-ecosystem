---
// src/_app/layouts/BaseLayout.astro
import SEOHead from '@/_shared/ui/SEOHead.astro';
import { MainHeader } from '@/_widgets/header';
import { MainFooter } from '@/_widgets/footer';
import { MainCookieConsent } from '@/_widgets/cookie-consent';
import { ThemeProvider } from '@/_app/providers/ThemeProvider';
import { QueryProvider } from '@/_app/providers/QueryProvider';
import { ClerkProvider } from '@/_app/providers/ClerkProvider';
import '@/_app/styles/globals.css';

export interface Props {
  lang?: string;
  children?: any;
  seoTitle?: string;
  seoDescription?: string;
  seoPath?: string;
  seoImage?: string;
  seoStructuredData?: Record<string, unknown>[];
}

const {
  lang = 'es',
  seoTitle = 'Datheón - Smart Tech Solutions',
  seoDescription = 'Datheón diseña y construye sistemas de software reales: software, IA, agentes, cloud e IoT.',
  seoPath = '/landing',
  seoImage = '/og-image.png',
  seoStructuredData = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOHead lang={lang} path={seoPath} title={seoTitle} description={seoDescription} image={seoImage} structuredData={seoStructuredData} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ThemeProvider>
      <QueryProvider>
        <ClerkProvider client:load>
          <MainHeader lang={lang} />
          <main>
            <slot />
          </main>
          <MainFooter lang={lang} />
          <MainCookieConsent lang={lang} />
        </ClerkProvider>
      </QueryProvider>
    </ThemeProvider>
  </body>
</html>