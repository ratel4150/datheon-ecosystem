---
// apps/landing-page/src/_widgets/header/ui/AuthButtons.astro
import { Button } from '@/_shared/ui/Button';
import type { Translations } from '@/_shared/types/i18n';

export interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<div class="flex items-center gap-3">
  <a 
    href="/login" 
    class="text-gray-300 hover:text-white transition-colors font-medium text-sm lg:text-base"
  >
    {t.auth.login}
  </a>
  <a 
    href="/register" 
    class="px-6 py-2 bg-[#00AEEF] text-white rounded-lg hover:bg-[#0098d4] transition-colors font-medium text-sm lg:text-base"
  >
    {t.auth.register}
  </a>
</div>
