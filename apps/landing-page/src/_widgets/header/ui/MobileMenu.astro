---
// apps/landing-page/src/_widgets/header/ui/MobileMenu.astro
import type { Translations, Locale } from '@/_shared/types/i18n';

export interface Props {
  t: Translations;
  lang: Locale;
}

const { t, lang } = Astro.props;

const links = [
  { href: '#platform', label: t.nav.platform },
  { href: '#academy', label: t.nav.academy },
  { href: '#casebook', label: t.nav.casebook },
  { href: '/pricing', label: t.nav.pricing },
];
---

<details class="md:hidden">
  <summary class="flex items-center justify-center w-10 h-10 rounded-lg text-gray-300 hover:bg-white/10 cursor-pointer list-none">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </summary>
  
  <div class="absolute top-full left-0 right-0 bg-[#0B0F2B] border border-white/10 rounded-b-2xl p-4 mt-2 mx-4">
    <nav class="flex flex-col gap-2">
      {links.map((link) => (
        <a 
          key={link.href} 
          href={link.href} 
          class="px-4 py-2 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="flex flex-col gap-2 mt-2 pt-2 border-t border-white/10">
        <a 
          href="/login" 
          class="px-4 py-2 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
        >
          {t.auth.login}
        </a>
        <a 
          href="/register" 
          class="px-4 py-2 bg-[#00AEEF] text-white rounded-lg text-center hover:bg-[#0098d4] transition-colors"
        >
          {t.auth.register}
        </a>
      </div>
    </nav>
  </div>
</details>
