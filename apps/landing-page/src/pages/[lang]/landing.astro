---
// src/pages/[lang]/landing.astro
import { HomePage } from '@/_pages/home';
import { BaseLayout } from '@/_app/layouts';
import { getTranslation } from '@/_shared/lib/i18n';

export async function getStaticPaths() {
  // Genera las rutas estáticas para los idiomas soportados
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
// Si no hay lang, por defecto 'es'
const currentLang = (lang as string) || 'es';
const t = getTranslation(currentLang);
---

<BaseLayout lang={currentLang}>
  <HomePage lang={currentLang} t={t} />
</BaseLayout>
