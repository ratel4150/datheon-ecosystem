---
// src/pages/[lang]/landing.astro
export const prerender = true;

import { HomePage } from '@/_pages/home';
import { BaseLayout } from '@/_app/layouts';
import { getTranslation } from '@/_shared/lib/i18n';
import { PAGE_META, buildOrganizationSchema, buildWebsiteSchema } from '@/_shared/lib/seo';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as 'es' | 'en' | 'fr') || 'es';
const t = getTranslation(currentLang);
const meta = PAGE_META.landing[currentLang];
---

<BaseLayout
  lang={currentLang}
  seoTitle={meta.title}
  seoDescription={meta.description}
  seoPath="/landing"
  seoStructuredData={[buildOrganizationSchema(), buildWebsiteSchema()]}
>
  <HomePage lang={currentLang} t={t} />
</BaseLayout>