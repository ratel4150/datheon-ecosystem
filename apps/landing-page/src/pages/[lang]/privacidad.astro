---
// src/pages/[lang]/privacidad.astro
export const prerender = true;

import { PrivacyPage } from '@/_pages/privacy';
import { BaseLayout } from '@/_app/layouts';
import { getTranslation } from '@/_shared/lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as 'es' | 'en' | 'fr') || 'es';
const t = getTranslation(currentLang);
---

<BaseLayout
  lang={currentLang}
  seoTitle="Datheón — Aviso de Privacidad"
  seoDescription="Cómo Datheón recopila, usa y protege tu información."
  seoPath="/privacidad"
>
  <PrivacyPage lang={currentLang} />
</BaseLayout>
