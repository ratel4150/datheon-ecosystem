---
// src/pages/[lang]/terminos.astro
export const prerender = true;

import { TermsPage } from '@/_pages/terms';
import { BaseLayout } from '@/_app/layouts';
import { getTranslation } from '@/_shared/lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as 'es' | 'en' | 'fr') || 'es';
const t = getTranslation(currentLang);
---

<BaseLayout
  lang={currentLang}
  seoTitle="Datheón — Términos de Servicio"
  seoDescription="Condiciones de uso del sitio y los servicios de Datheón."
  seoPath="/terminos"
>
  <TermsPage lang={currentLang} />
</BaseLayout>
